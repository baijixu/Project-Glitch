# Secrets / local config
.env
.env.*
!.env.example
config.yaml
config.local.*

# User-generated role-play profiles (brain/profiles.py) and Glitch souls
# (brain/souls.py) -- personal content, not source code.
brain/profiles/
brain/user.md
brain/roleplay_active.txt
brain/active_profile_name.txt
brain/souls/
brain/soul.md
brain/rp_soul.md
brain/active_soul_name.txt
brain/avatars/
brain/active_avatar.txt

# Whether Glitch's spoken voice is on (brain/voice_settings.py).
brain/voice_active.txt

# Whether Glitch's own LLM path can search the web (brain/web_search.py).
brain/web_search_active.txt

# Glitch's own native memory of the user (brain/memory.py) -- personal
# content, and separate from anything Hermes keeps in its own memory.
brain/memory.md
brain/memory_active.txt
brain/memory_provider.txt
# Can hold an api_key, same reasoning as tts_engines/llm_engines below.
brain/hindsight_config.json

# Saved speech (TTS) engine configs (brain/tts_engines.py) -- each file can
# hold an api_key, a secret same as config.yaml's.
brain/tts_engines/
brain/active_tts_engine_name.txt

# Saved LLM engine configs (brain/llm_engines.py) -- same reasoning.
brain/llm_engines/
brain/active_llm_engine_name.txt

# Which agent harness (if any) Glitch is currently plugged into (brain/harness.py),
# and which one the dropdown shows as picked while inactive.
brain/active_harness.txt
brain/selected_harness.txt
# Saved harness configs (brain/harness.py) -- same reasoning as tts_engines/
# and llm_engines/ above, each file can hold an api_key.
brain/harnesses/

# The user's own free-form notes (brain/notes.py) -- personal content, same
# category as user.md/memory.md above, never read by the LLM.
brain/notes.md

# Scratch dump of Kokoro's own OpenAPI spec from investigating its API --
# not read by any code, just a reference file, not project source.
brain/_kokoro_openapi.json

# Downloaded/blended Kokoro voice tensors (a saved TTS engine's own
# voices_dir, brain/kokoro_voices.py) -- generated binary data specific to
# this install, not source; can also include a personal blended voice.
kokoro_voices/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
npm-debug.log*
renderer/dist/

# OS
.DS_Store
Thumbs.db

# Behavior learning (brain/lessons.py) -- her saved lesson settings, the local
# record of retired/pending/candidate lessons, and the raw thumbs up/down log
# (contains real conversation text, so it stays local).
brain/lessons_active.txt
brain/lessons_autonomy.txt
brain/lessons_retired.json
brain/lessons_pending.json
brain/lessons_candidates.json
brain/ratings_log.jsonl
