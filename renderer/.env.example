# Mirrors config.yaml's brain.auth_token -- the Renderer can't read that
# YAML file directly (browser JS), so this is kept in sync by hand. Vite
# exposes VITE_-prefixed vars via import.meta.env.
#
# No VITE_BRAIN_WS_URL here anymore -- main.js derives it automatically
# from whatever host/protocol the page was actually loaded from (routed
# through Vite's own dev-server WebSocket proxy, see vite.config.js).
# Uncomment below only to point the Renderer at a Brain that ISN'T this
# same machine's Vite proxy (e.g. a Brain running elsewhere, unproxied).
# VITE_BRAIN_WS_URL=ws://localhost:8765
VITE_BRAIN_AUTH_TOKEN=
